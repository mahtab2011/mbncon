{
  "name": "@optifabric/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run prisma:generate && npm run prisma:generate:entitlement && nest build && npm run build:backfill-script",
    "build:backfill-script": "tsc -p tsconfig.scripts.json",
    "lint": "tsc --noEmit",
    "test": "jest",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "postinstall": "npm run prisma:generate && npm run prisma:generate:entitlement",
    "prisma:generate": "prisma generate",
    "prisma:generate:entitlement": "prisma generate --schema=prisma/entitlement/schema.prisma",
    "check:entitlement-schema-parity": "ts-node scripts/entitlement-schema-parity.ts",
    "backfill:optifabric-entitlements": "ts-node scripts/backfill-optifabric-entitlements.ts",
    "backfill:optifabric-entitlements:dry-run": "ts-node scripts/backfill-optifabric-entitlements.ts --dry-run",
    "backfill:optifabric-entitlements:apply": "ts-node scripts/backfill-optifabric-entitlements.ts --apply",
    "backfill:optifabric-entitlements:compiled:dry-run": "node dist/scripts/backfill-optifabric-entitlements.js --dry-run",
    "backfill:optifabric-entitlements:compiled:apply": "node dist/scripts/backfill-optifabric-entitlements.js --apply"
  },
  "dependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.0.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2"
  }
}
